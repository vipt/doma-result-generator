<?xml version="1.0" encoding="UTF-8"?>
<!-- Standalone so the portable core can be tested without downloading Eclipse. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.domaresult</groupId><artifactId>doma-result-generator-tests</artifactId><version>0.1.0-SNAPSHOT</version>
  <properties><maven.compiler.release>17</maven.compiler.release><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <dependencies>
    <dependency><groupId>org.seasar.doma</groupId><artifactId>doma-gen</artifactId><version>2.28.0</version>
      <exclusions><exclusion><groupId>org.seasar.doma</groupId><artifactId>doma</artifactId></exclusion>
      <exclusion><groupId>org.freemarker</groupId><artifactId>freemarker</artifactId></exclusion></exclusions>
    </dependency>
    <dependency><groupId>org.freemarker</groupId><artifactId>freemarker</artifactId><version>2.3.34</version></dependency>
    <dependency><groupId>org.apache.ant</groupId><artifactId>ant</artifactId><version>1.10.18</version></dependency>
    <dependency><groupId>org.eclipse.jdt</groupId><artifactId>org.eclipse.jdt.core</artifactId><version>3.36.0</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.9.3</version><scope>test</scope></dependency>
    <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><version>2.1.214</version><scope>test</scope></dependency>
    <dependency><groupId>org.seasar.doma</groupId><artifactId>doma-core</artifactId><version>2.57.0</version></dependency>
    <dependency><groupId>org.seasar.doma</groupId><artifactId>doma-processor</artifactId><version>2.57.0</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <sourceDirectory>../plugin/src</sourceDirectory>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.10.1</version><configuration><includes><include>io/github/domaresult/core/**</include><include>io/github/domaresult/merge/**</include></includes><proc>none</proc></configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>2.22.2</version></plugin>
    </plugins>
  </build>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
  <extension point="org.eclipse.ui.commands">
    <command id="io.github.domaresult.generate" name="Generate Doma Result Class..."/>
    <command id="io.github.domaresult.jumpToSql" name="Jump to Doma SQL"
      description="Open the SQL file for the DAO method at the cursor, including method calls"/>
  </extension>
  <extension point="org.eclipse.ui.handlers">
    <handler commandId="io.github.domaresult.generate" class="io.github.domaresult.ui.GenerateHandler"/>
    <handler commandId="io.github.domaresult.jumpToSql" class="io.github.domaresult.ui.JumpToSqlHandler">
      <activeWhen><with variable="activeEditorId"><equals value="org.eclipse.jdt.ui.CompilationUnitEditor"/></with></activeWhen>
    </handler>
  </extension>
  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="popup:#CompilationUnitEditorContext?after=additions">
      <command commandId="io.github.domaresult.jumpToSql" style="push"/>
    </menuContribution>
    <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
      <command commandId="io.github.domaresult.generate" style="push">
        <visibleWhen checkEnabled="false">
          <or>
            <with variable="activeMenuSelection">
              <and>
                <count value="1"/>
                <iterate ifEmpty="false"><adapt type="org.eclipse.core.resources.IFile"><test property="org.eclipse.core.resources.name" value="*.sql"/></adapt></iterate>
              </and>
            </with>
            <and>
              <with variable="activePart"><instanceof value="org.eclipse.ui.IEditorPart"/></with>
              <with variable="activeEditorInput"><adapt type="org.eclipse.core.resources.IFile"><test property="org.eclipse.core.resources.name" value="*.sql"/></adapt></with>
            </and>
          </or>
        </visibleWhen>
      </command>
    </menuContribution>
  </extension>
</plugin>

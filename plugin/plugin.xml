<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
  <extension point="org.eclipse.core.expressions.propertyTesters">
    <propertyTester id="io.github.domaresult.sqlFileTester" namespace="io.github.domaresult"
      properties="sqlFile" type="org.eclipse.core.resources.IFile" class="io.github.domaresult.ui.SqlFilePropertyTester"/>
  </extension>
  <extension point="org.eclipse.ui.commands">
    <command id="io.github.domaresult.generate" name="Generate Doma Result Class..."/>
  </extension>
  <extension point="org.eclipse.ui.handlers">
    <handler commandId="io.github.domaresult.generate" class="io.github.domaresult.ui.GenerateHandler"/>
  </extension>
  <extension point="org.eclipse.ui.menus">
    <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
      <command commandId="io.github.domaresult.generate" style="push">
        <visibleWhen checkEnabled="false">
          <or>
            <with variable="activeMenuSelection">
              <and>
                <count value="1"/>
                <iterate ifEmpty="false"><adapt type="org.eclipse.core.resources.IFile"><test property="io.github.domaresult.sqlFile" forcePluginActivation="true"/></adapt></iterate>
              </and>
            </with>
            <and>
              <with variable="activePart"><instanceof value="org.eclipse.ui.IEditorPart"/></with>
              <with variable="activeEditorInput"><adapt type="org.eclipse.core.resources.IFile"><test property="io.github.domaresult.sqlFile" forcePluginActivation="true"/></adapt></with>
            </and>
          </or>
        </visibleWhen>
      </command>
    </menuContribution>
  </extension>
</plugin>
